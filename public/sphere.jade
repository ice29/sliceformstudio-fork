.container(style="padding-top: 90px; padding-bottom: 40px")
  h2 Spherical Sliceform — 3D spike
  p.text-muted
    | Phase 0 proof-of-concept: a base polyhedron projected onto a sphere, with its
    | edges drawn as great-circle arcs. Drag to orbit, scroll to zoom. This sandbox
    | exists to validate the 3D substrate + preview before the full spherical mode.

  .form-inline(style="margin: 15px 0")
    .form-group
      label(style="margin-right: 8px") Base solid
      select#solidSelect.form-control
        option(value="tetrahedron") Tetrahedron
        option(value="cube") Cube
        option(value="octahedron") Octahedron
        option(value="icosahedron") Icosahedron
        option(value="dodecahedron", selected) Dodecahedron
    label.checkbox-inline(style="margin-left: 20px")
      input#showSphere(type="checkbox", checked)
      |  Show sphere
    label.checkbox-inline(style="margin-left: 12px")
      input#showVertices(type="checkbox", checked)
      |  Show vertices

  #sphereCanvas(style="width: 100%; height: 600px; background: #f7f7f7; border: 1px solid #ddd; border-radius: 4px")

  script(src="bower/three/three.min.js")
  script(src="bower/three/OrbitControls.js")
  script(src="js/sphere/spike.js")
